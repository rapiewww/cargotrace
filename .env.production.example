# CargoTrace Production Environment Configuration Template
# Copy this file to .env on your production host and configure secrets.

APP_NAME="Nusa Freight"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cargotrace.yourdomain.com

# Reverse Proxy / TLS Termination
TRUSTED_PROXIES=*

# Localization & Timezone
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Log to stderr for containerized environments)
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Database Connection (MySQL / MariaDB container)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cargotrace
DB_USERNAME=cargotrace
DB_PASSWORD=change_this_strong_password_in_production

# Session Security & Storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Caching & Queues
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Password Hashing
BCRYPT_ROUNDS=12

# Mail Configuration (Defaults to log; configure SMTP for real dispatch)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@cargotrace.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Demo Data Seeding (Only set to true if you explicitly want to seed synthetic data on startup)
SEED_DEMO_DATA=false

# CargoTrace Maritime Engine & External Integrations
CARGOTRACE_DELAY_LOW_HOURS=6
CARGOTRACE_DELAY_MEDIUM_HOURS=24
CARGOTRACE_FREE_DAYS_AFTER_ARRIVAL=5
CARGOTRACE_NOTIFICATIONS_EMAIL=false
CARGOTRACE_WEATHER_CRANE_CAUTION_KPH=28
CARGOTRACE_WEATHER_CRANE_SUSPENDED_KPH=40

# Map Tiles & Geocoding
CARGOTRACE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional Third-Party API Keys (silently skipped or gracefully degraded when unset)
GNEWS_API_KEY=
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=
NEWS_API_KEY=

